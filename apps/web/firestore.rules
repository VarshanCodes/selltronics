rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public storefront: only inventory explicitly published by the team is readable.
    match /products/{productId} {
      allow read: if resource.data.status == 'Available';
    }

    // A signed-in customer can access only their own history. Administrative
    // actions are deliberately handled by the password-protected admin service.
    match /sell_requests/{requestId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /buyOrders/{orderId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
    }

    // All other collections remain private. Admin operations should be performed
    // by authenticated staff with custom claims, or by a secure server endpoint.
  }
}
