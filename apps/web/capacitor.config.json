{
  "appId": "com.selltronics.app",
  "appName": "SellTronics",
  "webDir": "public",
  "server": {
    "url": "https://www.selltronics.store",
    "cleartext": false,
    "allowNavigation": [
      "www.selltronics.store",
      "selltronics.store",
      "*.selltronics.store"
    ]
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": [
        "google.com"
      ]
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "LIGHT"
    }
  }
}
